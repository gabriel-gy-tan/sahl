{
  "manifest_version": 3,
  "name": "Sahl browser companion",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "description": "Lets Sahl read and fill a form on this page. Documents and values stay on your computer.",
  "homepage_url": "https://github.com/gabriel-gy-tan/sahl",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "http://127.0.0.1:8770/*",
    "http://127.0.0.1:8771/*",
    "http://127.0.0.1:8772/*",
    "http://127.0.0.1:8773/*",
    "http://127.0.0.1:8774/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sahl",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
